# Copy to .env (backend, same folder as backend/) or set in Yandex Lockbox / VM env.
# NEVER commit real secrets. Rotate any keys that were ever exposed in chat or repos.
#
# Локально (без продакшена): можно использовать app/backend/.env_development — он в .gitignore,
# подхватывается только если ENVIRONMENT != prod (в Yandex задайте ENVIRONMENT=prod).

# --- PostgreSQL (async URL; use postgresql+asyncpg:// or plain postgresql:// — backend normalizes) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?ssl=true

# --- JWT (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Public URLs (production: nutriaidiary.com) ---
FRONTEND_URL=https://nutriaidiary.com
PYTHON_BACKEND_URL=https://api.nutriaidiary.com

# --- OpenRouter (backend reads APP_AI_* in aihub) ---
APP_AI_BASE_URL=https://openrouter.ai/api/v1
APP_AI_KEY=

# Прокси только для запросов к AI-провайдеру (остальной трафик идёт напрямую).
# Нужен, если Cloudflare перед openrouter.ai блокирует IP сервера:
# 403 {"success": false, "error": "Access denied by security policy."}
# Формат: http://user:pass@host:port или socks5://127.0.0.1:40000
APP_AI_PROXY=

# Optional OpenRouter attribution (add in code if API requires)
# OPENROUTER_HTTP_REFERER=https://nutriaidiary.com
# OPENROUTER_APP_NAME=Nutriaidiary

# --- Admin bootstrap (optional) ---
# ADMIN_USER_ID=
# ADMIN_USER_EMAIL=
# Dev only: sets admin password hash on startup if admin has no password (ENVIRONMENT=dev)
# ADMIN_BOOTSTRAP_PASSWORD=

# --- YooKassa (payments) ---
YOOKASSA_SHOP_ID=1317246
YOOKASSA_SECRET_KEY=test_...
YOOKASSA_RETURN_URL=https://nutriaidiary.com/payment/success

# --- Optional: external OSS (storage router) ---
# OSS_SERVICE_URL=
# OSS_API_KEY=

# --- Telegram Bot ---
# Create bot via @BotFather in Telegram, get token
TELEGRAM_BOT_TOKEN=

# --- Resend (email verification on registration) ---
# Get API key at https://resend.com → API Keys. Verify your sending domain in Resend → Domains.
# Until the domain is verified you can set RESEND_FROM_EMAIL=onboarding@resend.dev (delivers only to your account email).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@nutriaidiary.com
RESEND_FROM_NAME=NutryAI

# --- Runtime ---
ENVIRONMENT=prod
PORT=8000

# Optional extra CORS origins (comma-separated), appended to default nutriaidiary + localhost list in main.py
# CORS_EXTRA_ORIGINS=https://staging.nutriaidiary.com

# --- Frontend build (Next.js in app/web) — set at build time or in hosting ---
# NEXT_PUBLIC_API_BASE_URL=https://api.nutriaidiary.com
