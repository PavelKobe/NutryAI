# Copy to .env (backend, same folder as backend/) or set in Yandex Lockbox / VM env.
# NEVER commit real secrets. Rotate any keys that were ever exposed in chat or repos.

# --- PostgreSQL (async URL; use postgresql+asyncpg:// or plain postgresql:// — backend normalizes) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?ssl=true

# --- JWT (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Google OIDC ---
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile

# --- Public URLs (production: nutriaidiary.com) ---
FRONTEND_URL=https://nutriaidiary.com
PYTHON_BACKEND_URL=https://api.nutriaidiary.com

# --- OpenRouter (backend reads APP_AI_* in aihub) ---
APP_AI_BASE_URL=https://openrouter.ai/api/v1
APP_AI_KEY=

# Optional OpenRouter attribution (add in code if API requires)
# OPENROUTER_HTTP_REFERER=https://nutriaidiary.com
# OPENROUTER_APP_NAME=Nutriaidiary

# --- Admin bootstrap (optional) ---
# ADMIN_USER_ID=
# ADMIN_USER_EMAIL=

# --- Optional: Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=

# --- Optional: external OSS (storage router) ---
# OSS_SERVICE_URL=
# OSS_API_KEY=

# --- Runtime ---
ENVIRONMENT=prod
PORT=8000

# Optional extra CORS origins (comma-separated), appended to default nutriaidiary + localhost list in main.py
# CORS_EXTRA_ORIGINS=https://staging.nutriaidiary.com

# --- Frontend build (Next.js in app/web) — set at build time or in hosting ---
# NEXT_PUBLIC_API_BASE_URL=https://api.nutriaidiary.com
