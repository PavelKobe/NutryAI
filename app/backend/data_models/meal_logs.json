        },
        "fat": {
            "type": "number",
            "description": "Fat in grams"
        },
        "carbs": {
            "type": "number",
            "description": "Carbs in grams"
        },
        "portion_grams": {
            "type": "number",
            "description": "Portion size in grams"
        },
        "photo_url": {
            "type": "string",
            "description": "URL of food photo"
        },
        "logged_at": {
            "type": "string",
