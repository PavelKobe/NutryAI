        },
        "user_id": {
            "type": "string",
            "description": "User ID from auth"
        },
        "meal_type": {
            "type": "string",
            "description": "breakfast, lunch, dinner, snack"
        },
        "food_name": {
            "type": "string",
            "description": "Name of the food"
        },
        "calories": {
            "type": "number",
            "description": "Calories"
        },
        "protein": {
            "type": "number",
