# Build-time / runtime for Next (also pass as Docker build args)
NEXT_PUBLIC_API_BASE_URL=https://api.nutriaidiary.com
NEXT_PUBLIC_SITE_URL=https://nutriaidiary.com

# Куда Next проксирует /api/v1/aihub/* (стриминг ИИ из SDK). На одной ВМ с API:
# INTERNAL_API_BASE_URL=http://127.0.0.1:8000
# В Docker Compose (сервис api): INTERNAL_API_BASE_URL=http://api:8000
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
