# Шаблон для /etc/nginx/sites-available/nutriaidiary (Ubuntu: sites-enabled).
# Скопируйте: cp nginx.conf.example nginx.conf — правьте nginx.conf локально (в git не коммитится).
# После certbot появятся listen 443 ssl и include ssl — не затирайте вручную без нужды.
#
# Этап HTTP (порт 80). Certbot:
#   sudo certbot --nginx -d nutriaidiary.com -d www.nutriaidiary.com -d admin.nutriaidiary.com -d api.nutriaidiary.com

# ──────────────────────────────────────────────────────────────────────────────
# Rate Limiting — зоны объявляются в http {} контексте (выше server блоков).
# При использовании с Nginx в /etc/nginx/nginx.conf добавьте эти директивы
# внутрь блока http {} (или в отдельный conf-файл в /etc/nginx/conf.d/).
#
# auth_limit  — строгий лимит для эндпоинтов аутентификации: 10 req/min per IP
# api_limit   — мягкий лимит для всех остальных API: 100 req/min per IP
# ──────────────────────────────────────────────────────────────────────────────
# limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;
# limit_req_zone $binary_remote_addr zone=api_limit:10m  rate=100r/m;

# Фронт Next.js
server {
    listen 80;
    server_name nutriaidiary.com www.nutriaidiary.com;
    access_log /var/log/nginx/nutriaidiary-web-access.log;
    error_log  /var/log/nginx/nutriaidiary-web-error.log;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}

# Админ-панель (тот же Next :3000)
server {
    listen 80;
    server_name admin.nutriaidiary.com;
    access_log /var/log/nginx/nutriaidiary-admin-access.log;
    error_log  /var/log/nginx/nutriaidiary-admin-error.log;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}

# API FastAPI
# CORS отдаёт FastAPI (main.py). Не дублировать add_header Access-Control-* здесь.
# Rate limiting: раскомментировать limit_req_zone выше и применить ниже.
server {
    listen 80;
    server_name api.nutriaidiary.com;
    access_log /var/log/nginx/nutriaidiary-api-access.log;
    error_log  /var/log/nginx/nutriaidiary-api-error.log;
    client_max_body_size 25m;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Строгий лимит для эндпоинтов аутентификации (защита от brute-force)
    # burst=5 — разрешает кратковременные пики; nodelay — не ставить в очередь
    location /api/v1/auth/ {
        # limit_req zone=auth_limit burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $http_origin;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Мягкий лимит для всех остальных API-эндпоинтов
    location /api/v1/ {
        # limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $http_origin;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Catchall: health check, корень
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $http_origin;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
